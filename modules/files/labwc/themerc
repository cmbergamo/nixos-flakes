# Labwc themerc - Tema escuro harmonizado com LXQt e Openbox

# general
border.width: 1
padding.height: 4

# window border
window.active.border.color: #3b4252
window.inactive.border.color: #2e3440

# window titlebar background
window.active.title.bg.color: #2e3440
window.inactive.title.bg.color: #242933

# window titlebar text
window.active.label.text.color: #eceff4
window.inactive.label.text.color: #7b88a1
window.label.text.justify: center

# window buttons
window.active.button.close.unpressed.image.color: #bf616a
window.active.button.max.unpressed.image.color: #a3be8c
window.active.button.iconify.unpressed.image.color: #ebcb8b
window.inactive.button.unpressed.image.color: #4c566a

# menu
menu.overlap.x: 0
menu.overlap.y: 0
menu.width.min: 20
menu.width.max: 220
menu.items.bg.color: #2e3440
menu.items.text.color: #eceff4
menu.items.active.bg.color: #434c5e
menu.items.active.text.color: #88c0d0
menu.items.padding.x: 8
menu.items.padding.y: 5
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3
menu.separator.color: #3b4252

# on screen display (window-cycle dialog)
osd.bg.color: #2e3440
osd.border.color: #434c5e
osd.border.width: 1
osd.label.text.color: #eceff4
